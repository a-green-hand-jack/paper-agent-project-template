% paper-harness.sty
% Reusable presentation macros for the article layout of the three builds.
% Project-specific macros belong in paper/macros.tex, not here: this file
% must stay swappable (for compat.sty under a venue kit) without touching
% paper/sections/*.tex. T1 font encoding keeps underscores and other
% characters intact in the PDF text layer; make check verifies it.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{paper-harness}[2026/10/20 v1.2 reusable paper display macros for paper-agent-project-template]

\RequirePackage[T1]{fontenc}
\RequirePackage{etoolbox}
\RequirePackage{amsmath}
\RequirePackage{xcolor}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{pifont}

% ---------------------------------------------------------------------
% Optional accent theme: \papercolor{<name>}, \paperstyle{accent|plain}
% ---------------------------------------------------------------------
\definecolor{paperAccentblue}{HTML}{1B4F8C}
\definecolor{paperAccentslate}{HTML}{2E2E2E}
\definecolor{paperAccentforest}{HTML}{1F5C3E}
\colorlet{paperAccent}{paperAccentblue}

\newbool{paperAccentEnabled}
\booltrue{paperAccentEnabled}

\newcommand{\papercolor}[1]{%
  \ifstrequal{#1}{blue}{\colorlet{paperAccent}{paperAccentblue}}{%
  \ifstrequal{#1}{slate}{\colorlet{paperAccent}{paperAccentslate}}{%
  \ifstrequal{#1}{forest}{\colorlet{paperAccent}{paperAccentforest}}{%
    \PackageError{paper-harness}{Unknown paper color `#1'}{Available colors: blue, slate, forest.}%
  }}}%
}

\newcommand{\paperstyle}[1]{%
  \ifstrequal{#1}{accent}{\booltrue{paperAccentEnabled}}{%
  \ifstrequal{#1}{plain}{\boolfalse{paperAccentEnabled}}{%
    \PackageError{paper-harness}{Unknown paper style `#1'}{Available styles: accent, plain.}%
  }}%
}

% ---------------------------------------------------------------------
% Display API: heading and cross-reference helpers
% ---------------------------------------------------------------------
\newcommand{\headbf}[1]{{\bfseries\ifbool{paperAccentEnabled}{\color{paperAccent}}{}#1}}
\newcommand{\parahead}[1]{\par\noindent\headbf{#1.}\enspace\ignorespaces}

\newcommand{\figref}[1]{Figure~\ref{#1}}
\newcommand{\tabref}[1]{Table~\ref{#1}}
\newcommand{\algref}[1]{Algorithm~\ref{#1}}
\newcommand{\eqnref}[1]{Equation~\eqref{#1}}

% ---------------------------------------------------------------------
% Display API: compact table helpers
% ---------------------------------------------------------------------
\newcommand{\tablestyle}[2]{\setlength{\tabcolsep}{#1}\renewcommand{\arraystretch}{#2}\centering\small}
\newcommand{\cmark}{\ding{51}}
\newcommand{\xmark}{\ding{55}}

\newcolumntype{x}[1]{>{\centering\arraybackslash}p{#1pt}}
\newcolumntype{y}[1]{>{\raggedright\arraybackslash}p{#1pt}}
\newcolumntype{z}[1]{>{\raggedleft\arraybackslash}p{#1pt}}
\newcolumntype{P}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\centering\arraybackslash}X}

\endinput
